# ============================================
# Kredensial Lazada Open Platform (server-only)
# JANGAN commit file .env yang berisi nilai asli.
# Isi di Vercel: Project Settings -> Environment Variables
# ============================================

# Dari https://open.lazada.com (App Key & Secret saat membuat aplikasi)
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Dari alur OAuth (access token seller)
LAZADA_ACCESS_TOKEN=

# Opsional: untuk refresh token otomatis
LAZADA_REFRESH_TOKEN=

# Endpoint API (default Indonesia). Ganti sesuai negara toko.
# LAZADA_API_BASE=https://api.lazada.co.id/rest

# Kunci admin: diketik manual per aksi sinkron (tidak pernah dikirim ke browser)
LAZADA_ADMIN_KEY=

# Flag kunci: sinkron HANYA terbuka bila = "true" + kredensial lengkap
LAZADA_SYNC_ENABLED=false
