# CONTOH Environment Variable — integrasi TikTok Shop (by Tokopedia).
# SALIN ke Vercel Dashboard > Project > Settings > Environment Variables.
# JANGAN pernah commit file .env berisi nilai asli ke Git.

# --- TikTok Shop Partner Center (App / OAuth client) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# --- Hasil otorisasi seller (OAuth 2.0) — RAHASIA, server saja ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_ID=
TIKTOK_SHOP_CIPHER=

# --- Konfigurasi ---
# Base URL Open API (sesuaikan region bila TikTok memberi endpoint berbeda)
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com

# FLAG PENGAMAN: wajib "true" untuk membuka /api/tiktok/sync. Default: terkunci.
TIKTOK_SYNC_ENABLED=false

# Kunci admin untuk aksi sync (bebas, min. 24 karakter acak). Diketik per aksi, tidak disimpan di browser.
TIKTOK_ADMIN_KEY=
