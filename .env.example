# ============================================
# Kredensial Lazada Open Platform (server-only)
# JANGAN commit file .env yang berisi nilai asli.
# Isi di Vercel: Project Settings -> Environment Variables
# ============================================

# Dari https://open.lazada.com (App Key & Secret saat membuat aplikasi)
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Dari alur OAuth (access token seller)
LAZADA_ACCESS_TOKEN=

# Opsional: untuk refresh token otomatis
LAZADA_REFRESH_TOKEN=

# Endpoint API (default Indonesia). Ganti sesuai negara toko.
# LAZADA_API_BASE=https://api.lazada.co.id/rest

# Kunci admin: diketik manual per aksi sinkron (tidak pernah dikirim ke browser)
LAZADA_ADMIN_KEY=

# Flag kunci: sinkron HANYA terbuka bila = "true" + kredensial lengkap
LAZADA_SYNC_ENABLED=false

# ============================================
# Tokopedia & TikTok Shop (Partner Center, server-only)
# ============================================
# Dari https://partner.tiktokshop.com → App detail (App & Service)
TOKOPEDIA_APP_KEY=
TOKOPEDIA_APP_SECRET=
# Opsional bila service_id terpisah dari App Key
TOKOPEDIA_SERVICE_ID=
# Kunci admin panel; kosongkan bila pakai LAZADA_ADMIN_KEY yang sama
TOKOPEDIA_ADMIN_KEY=
# Isi SETELAH otorisasi (halaman callback menampilkannya), lalu Redeploy
TOKOPEDIA_ACCESS_TOKEN=
TOKOPEDIA_REFRESH_TOKEN=
TOKOPEDIA_ACCESS_TOKEN_EXPIRE_IN=
# Info toko
TOKOPEDIA_SHOP_CODE=IDLCDX7LWKL

# Flag kunci sinkron produk TikTok: HANYA terbuka bila = "true" + token lengkap
# (create product & push stok tetap perlu adminKey + confirm:true di panel)
TOKOPEDIA_SYNC_ENABLED=false
